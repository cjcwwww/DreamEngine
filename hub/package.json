{
  "name": "dreamengine-hub",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "DreamEngine Hub —— 不依赖 After Effects 的控制台：添加预设、离线渲染预览、安装与诊断",
  "author": "DreamEngine",
  "main": "main.js",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start.ps1",
    "selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start.ps1 --selftest",
    "test": "node --test \"test/*.test.js\"",
    "build:resources": "node ../tools/prepare_hub_bundle.mjs",
    "pack": "node ../tools/build_hub.mjs --dir",
    "dist": "node ../tools/build_hub.mjs --win nsis",
    "test:package": "node ../tools/test-hub-package.mjs",
    "test:release": "node ../tools/test-hub-release.mjs"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.dreamengine.hub",
    "productName": "DreamEngine Hub",
    "artifactName": "DreamEngine-Hub-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "core/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/release/panel",
        "to": "panel"
      },
      {
        "from": "build/release/tools",
        "to": "tools"
      },
      {
        "from": "build/release/installer",
        "to": "installer"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
